# Text files are stored and checked out with LF on every OS (the tools and tests expect LF).
* text=auto eol=lf
# Windows command scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
# Binary assets and release artefacts.
*.png binary
*.jpg binary
*.webp binary
*.gif binary
*.mp4 binary
*.ico binary
*.glb binary
*.mfpack binary
*.apk binary
*.zip binary
*.jar binary
