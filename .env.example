# Copy to apps/editor/.env.local and fill in. Never commit real values.
# Base URL of the official Mythic Bharat Studios asset repository (HTTPS required).
# Leave empty to use only the catalog bundled with the app (fully offline).
VITE_ASSET_REPOSITORY_URL=
# Public links shown in Settings → About. Leave empty until they exist.
VITE_WEBSITE_URL=
VITE_SUPPORT_URL=
VITE_PRIVACY_POLICY_URL=
VITE_TERMS_URL=
